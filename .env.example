NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required by privileged server-only operations; never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Enable only after the matching provider and every deployed callback URL are configured in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false
# Optional public social profile displayed in the public footer when configured.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/prepdmat
# Optional independent HMAC key (32+ characters); service role is the server-only fallback.
SECURITY_RATE_LIMIT_SECRET=
# Trust only a header that the production edge overwrites and strips from direct clients.
TRUSTED_CLIENT_IP_HEADER=none
# Initial launch policy: every published test is available without paid entitlement.
FREE_LAUNCH_ACCESS_ENABLED=true
# Student General Academic requires both switches; leave false in production.
GENERAL_ACADEMIC_ENABLED=false
NEXT_PUBLIC_GENERAL_ACADEMIC_ENABLED=false
ENABLE_ON_DEMAND_CORE_MOCKS=false
CORE_MOCK_HISTORY_WINDOW=3
CORE_MOCK_GENERATION_COOLDOWN_SECONDS=30

# Optional, server-only General Academic generation. Manual authoring and JSON import do not require these.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=sk-676fde6042e6bb76-a29045-1c67e410
OMNIROUTE_GAM_MODEL=amidia-ai
OMNIROUTE_GAM_TIMEOUT_MS=55000
OMNIROUTE_GAM_DAILY_LIMIT=25
